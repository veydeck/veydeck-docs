{
  "name": "veydeck-api-registry",
  "version": "0.1.0-alpha.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "format": "oxfmt src/ scripts/ vite.config.ts",
    "build:favicon": "node scripts/build-favicon.mjs",
    "validate": "node scripts/validate.mjs",
    "check": "run-s validate type-check build-only"
  },
  "dependencies": {
    "@scalar/openapi-parser": "^0.28.7",
    "@scalar/openapi-types": "^0.9.1",
    "@veydeck/icons": "0.1.0-alpha.1",
    "@veydeck/tokens": "0.1.0-alpha.1",
    "@veydeck/vue": "0.1.0-alpha.1",
    "vue": "^3.5.38",
    "vue-router": "^5.1.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^24.13.2",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/tsconfig": "^0.9.1",
    "npm-run-all2": "^9.0.2",
    "oxfmt": "^0.54.0",
    "png-to-ico": "^3.0.1",
    "sharp": "^0.35.2",
    "typescript": "~6.0.0",
    "vite": "^8.0.16",
    "vite-plugin-vue-devtools": "^8.1.2",
    "vue-tsc": "^3.3.5"
  },
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  }
